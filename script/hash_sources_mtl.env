# Paths that affect the MTL (libmtl) build artifact.
# One path per line (glob-free). Relative to repository root.

# CICD dependency
script/mtl_install.sh
script/mtl_install_dependencies.sh

# meson.build installs the host tools with the mtl_common.sh they source
script/mtl_nicctl.sh
script/mtl_dma_setup.sh
script/mtl_status_report.sh
script/mtl_isolation_report.sh
script/mtl_isolation_monitor.sh
script/mtl_lcore_stat_dump.sh
script/mtl_if_filter_delete.sh
script/isolation_expected.env
script/isolation_allowed.env
script/mtl_common.sh

# build.sh writes the plugin registry, cached with MTL, with the plugin paths
# of these two
script/mtl_build_jpegxs.sh
script/mtl_build_st22_avcodec_plugin.sh

# Top-level build/install driver (selects prefix and install steps)
build.sh

# Sanity check
script/hash_sources_mtl.env

meson.build
meson_options.txt
lib/
include/
versions.env

# build.sh installs the sample plugin and ld_preload with libmtl
plugins/meson.build
plugins/meson_options.txt
plugins/log.h
plugins/plugin_platform.h
plugins/sample/
ld_preload/

# manager
manager/
VERSION

# RxTxApp
tests/tools/RxTxApp/
app/

# gtest section
tests/integration_tests/
tests/meson.build
tests/meson_options.txt
