#
# The options of script/mtl_install.sh. To use this file:
#
#   cp script/mtl_install_template.env my_setup.env
#   $EDITOR my_setup.env                     # set each option that you need to 1
#   source my_setup.env
#   ./script/mtl_install.sh --dry-run        # show the steps, change nothing
#   ./script/mtl_install.sh                  # do the steps
#
# Each option is 0 (off) or 1 (on). The script stops for another value, and
# for a variable with the prefix of an option that is not an option.
# "./script/mtl_install.sh -h" tells what each option does.
# The file is a shell script: keep each line as "export NAME=VALUE".

# ---------------------------------------------------------------- Install prefix
# Empty: install into the system (/usr/local), with sudo.
# A path, such as "$PWD/.local_install/mtl": install MTL there, and each other
# component in a directory beside it (.local_install/dpdk, .local_install/ffmpeg).
export MTL_INSTALL_PREFIX=""

# ---------------------------------------------------------------- Host (before MTL)
# The build packages of each selected component. Ubuntu only: on another
# distribution, install them yourself and keep 0.
export SETUP_ENVIRONMENT=1
# GPU Direct (gpu_direct/), into the system.
export SETUP_BUILD_AND_INSTALL_GPU_DIRECT=0
# xdp-tools and libbpf for the AF_XDP backend, into the system. Before MTL.
export SETUP_BUILD_AND_INSTALL_EBPF_XDP=0
# DPDK of versions.env with the MTL patches. Rebuilds on each run.
export SETUP_BUILD_AND_INSTALL_DPDK=1
# The ice and igc kernel drivers. Or select only one of them below.
export SETUP_BUILD_AND_INSTALL_DRIVERS=0
# The ice driver, for E810 and E830.
export SETUP_BUILD_AND_INSTALL_DRIVERS_ICE=0
# The igc driver, for I225 and I226.
export SETUP_BUILD_AND_INSTALL_DRIVERS_IGC=0

# ---------------------------------------------------------------- MTL
# MTL, the apps and the manager, release build.
export MTL_BUILD_AND_INSTALL=1
# The same as a debug build. It replaces the release build.
export MTL_BUILD_AND_INSTALL_DEBUG=0
# The libFuzzer harnesses. Needs clang, and one of the two MTL options above.
export MTL_BUILD_AND_INSTALL_FUZZ=0
# Build and run the unit tests instead of the MTL install: MTL is not installed.
# Needs one of the two MTL options above.
export MTL_BUILD_AND_INSTALL_UNIT_TESTS=0
# The Docker image mtl:latest.
export MTL_BUILD_AND_INSTALL_DOCKER=0
# The Docker image mtl-manager:latest.
export MTL_BUILD_AND_INSTALL_DOCKER_MANAGER=0

# ---------------------------------------------------------------- Plugins and ecosystem (after MTL)
# SVT JPEG XS and its ST 2110-22 plugin.
export PLUGIN_BUILD_AND_INSTALL_JPEGXS=0
# FFmpeg with the MTL devices. With JPEG XS above, it also links JPEG XS.
export ECOSYSTEM_BUILD_AND_INSTALL_FFMPEG_PLUGIN=0
# The GStreamer plugins and test tools, debug build.
export ECOSYSTEM_BUILD_AND_INSTALL_GSTREAMER_PLUGIN=0
# Build the GStreamer plugins as release (-Werror). Needs the option above.
export ECOSYSTEM_BUILD_GSTREAMER_PLUGIN_RELEASE=0
# The OBS Studio plugin, into the system.
export ECOSYSTEM_BUILD_AND_INSTALL_OBS_PLUGIN=0
# The sample plugins of plugins/, into the system.
export PLUGIN_BUILD_AND_INSTALL_SAMPLE=0
# The ST 2110-22 avcodec plugin.
export PLUGIN_BUILD_AND_INSTALL_AVCODEC=0

# ---------------------------------------------------------------- Bindings (after MTL)
# SWIG 4.1.1 and the Python binding, into the system python3.
export HOOK_PYTHON=0
# The Rust binding.
export HOOK_RUST=0

# ---------------------------------------------------------------- Tools
export TOOLS_BUILD_AND_INSTALL_MTL_MONITORS=0
export TOOLS_BUILD_AND_INSTALL_MTL_READPCAP=0
export TOOLS_BUILD_AND_INSTALL_MTL_CPU_EMULATOR=0
export TOOLS_BUILD_AND_INSTALL_SET_TAI_OFFSET=0
# Run set_tai_offset as root: set the TAI offset of the kernel.
export TOOLS_RUN_SET_TAI_OFFSET=0

# ---------------------------------------------------------------- CI
# Stop at the first failed package install. For CI and containers.
export CICD_BUILD=0
