# EditorConfig -- https://editorconfig.org
#
# Deliberately minimal. Layout is owned by the formatters in
# .pre-commit-config.yaml: clang-format for C/C++, black for Python, shfmt for
# shell. Repeating their indent widths here would create a fourth source of truth
# that nothing verifies and that silently disagrees the moment one of them is
# bumped. So this file carries only what a formatter does *not* decide -- encoding
# and line endings -- plus the one entry that is functionally required.
#
# That entry is [*.sh]: shfmt reads EditorConfig files, so leaving indent_style
# unset there would leave shell formatting dependent on shfmt's built-in default
# rather than on something written down. See doc/coding_standard.md.

root = true

[*]
charset = utf-8
end_of_line = lf

# Deliberately no insert_final_newline: 152 tracked files have no trailing
# newline, no hook enforces it, and a rule stated in a file that nothing checks
# is exactly the drift this file's header warns about.

[*.sh]
indent_style = tab

# Vendored third-party patch series: byte-exact, no editor conversions.
[patches/**]
charset = unset
end_of_line = unset
