# EditorConfig -- https://editorconfig.org
#
# Keep text files on UTF-8 with LF line endings and shell indentation on tabs.

root = true

[*]
charset = utf-8
end_of_line = lf

[*.sh]
indent_style = tab

# Vendored third-party patch series: byte-exact, no editor conversions.
[patches/**]
charset = unset
end_of_line = unset
