# RDT QoS validation against noisy neighbor "host-a" at 20 pinned streams.
#
# Row 1 is the unmanaged reference: the noise runs at full strength and RDT only
# measures. Every later row repeats the identical workload with one RDT policy
# applied to the noise group, so the summary rows differ by exactly one variable.
#
# Read the result with scripts/summarize.sh and compare, for each row:
#   rdt_noise_llc_occupancy_mib   should fall when CAT is applied
#   rdt_noise_total_mbm_gbps      should fall when MBA is applied
#   minimum_encoder_fps           must reach 59.5 for the policy to be a fix
#   l3_cache_hit_ratio_pct        should recover towards the clean-run value
pinned --streams 20 --noisy-neighbor host-a --rdt-monitor              --warmup 1m --measure 2m
pinned --streams 20 --noisy-neighbor host-a --rdt-control mba-80       --warmup 1m --measure 2m
pinned --streams 20 --noisy-neighbor host-a --rdt-control mba-20       --warmup 1m --measure 2m
pinned --streams 20 --noisy-neighbor host-a --rdt-control cat-guarded  --warmup 1m --measure 2m
pinned --streams 20 --noisy-neighbor host-a --rdt-control cat-strong   --warmup 1m --measure 2m
pinned --streams 20 --noisy-neighbor host-a --rdt-control cat-16-1     --warmup 1m --measure 2m
pinned --streams 20 --noisy-neighbor host-a --rdt-control cat-16-1+mba-20 --warmup 1m --measure 2m
