# Find the density limit on new hardware: walk the stream count up until a run
# fails the 59.5 FPS floor. Start below the reference numbers and stop when
# summarize shows the first FAIL for a scenario.
baseline  --streams 10 --warmup 1m --measure 2m
baseline  --streams 12 --warmup 1m --measure 2m
baseline  --streams 14 --warmup 1m --measure 2m
numa-pool --streams 12 --warmup 1m --measure 2m
numa-pool --streams 14 --warmup 1m --measure 2m
numa-pool --streams 16 --warmup 1m --measure 2m
pinned    --streams 18 --warmup 1m --measure 2m
pinned    --streams 20 --warmup 1m --measure 2m
pinned    --streams 22 --warmup 1m --measure 2m
