# Lab defaults. Every value can be overridden by a scenario file, by an
# environment variable of the same name, or by `--set KEY=VALUE` on the CLI.
# Precedence: config/lab.env < scenarios/<name>.env < environment < noisy-neighbor profile < --set

# ---------------------------------------------------------------- cluster ----
LAB_NAMESPACE=mxl-perf
LAB_APP=mxl-perf
# Kubernetes node names, exactly as `kubectl get nodes` prints them. Change
# these to match your cluster and keep config/nodes.env in step: each worker
# needs a <NODE_NAME>_HOST entry there. LAB_WORKERS is a comma-separated list.
LAB_CONTROLLER=control-plane
LAB_WORKERS=worker-1
LAB_DEFAULT_NODE=worker-1

# Proxy, if this network has one. Set it here once and the cluster installer
# configures apt, containerd, kubeadm and kubectl from it on every node - each of
# those reads a different place, and a missed one is the most common way the
# install fails. Leave both commented out on a direct connection; then the
# installer falls back to http_proxy/https_proxy from your own shell and from each
# node's /etc/environment. See docs/02-kubernetes-install.md "Behind a proxy".
#LAB_HTTP_PROXY=http://proxy.example.com:911
#LAB_HTTPS_PROXY=http://proxy.example.com:912

# --------------------------------------------------------------- workload ----
# Container image built by scripts/build-ffmpeg-mxl-image.sh and imported into
# containerd on every worker. Pull policy Never keeps runs offline-reproducible.
LAB_IMAGE=localhost/mxl-ffmpeg-full:v1
LAB_IMAGE_PULL_POLICY=Never
LAB_FFMPEG=/opt/bin/ffmpeg
LAB_MEDIA_HOSTPATH=/opt/mxl-media
LAB_MEDIA_MOUNT=/media
LAB_MXL_HOSTPATH=/dev/shm/mxl
LAB_MXL_MOUNT=/dev/shm/mxl
LAB_INPUT_1080P=Mixed_40sec_1920x1080_60fps_8bit_420_crf23_veryslow.mp4
LAB_INPUT_4K=Mixed_40sec_3840x2160_60fps_10bit_420_crf23_veryslow.mp4

# ---------------------------------------------------------- observability ----
# Prometheus is reached through scripts/port-forward-prometheus.sh.
LAB_PROM_URL=http://127.0.0.1:19090
LAB_PROM_RELEASE=monitoring

# -------------------------------------------------------------- measuring ----
LAB_RESULTS_DIR=results
# A run passes when every encoder stream sustains at least this frame rate
# across the whole measurement window.
LAB_MIN_FPS=59.5
LAB_WARMUP=60
LAB_DURATION=120
LAB_STEP=5

# ---------------------------------------------------- worker CPU topology ----
# Describe the worker you measure on. Read the values off the worker with
# `lscpu` and `lscpu -p=CPU,CORE,NODE`; docs/02-kubernetes-install.md walks
# through it, and every run records config-vs-hardware mismatches in host.json.
# The planner models 2 sockets; both CPU-ID numbering schemes are supported.
# RESERVED_CPUS is kept away from the workload for the kubelet, the metrics
# exporters and housekeeping - use at least two CPUs per socket, and whole cores
# with SMT on (the sibling of CPU N is N + sockets*cores_per_socket): under
# full-pcpus-only mxlperf refuses a half-reserved core.
# The reference platform in docs/14-reference-bkc.md has 2 sockets x 64
# cores, 1 thread/core, alternating CPU IDs.
LAB_SOCKET_COUNT=2
LAB_CORES_PER_SOCKET=32
# Hardware threads per physical core: 1 with Hyper-Threading disabled, 2 with it
# enabled. DEC_CORES, ENC_CORES and a Guaranteed NOISY_NEIGHBOR_CPU_REQUEST are
# always counted in *physical cores*; the CPU request the kubelet sees is
# cores x LAB_THREADS_PER_CORE, which is what full-pcpus-only demands. So a
# scenario keeps the same physical footprint whether SMT is on or off.
LAB_THREADS_PER_CORE=1
# "alternating": socket membership follows even/odd core IDs, and
# LAB_SOCKET0_PARITY says which parity socket 0 owns ("even" = 0,2,4,...).
# "contiguous": socket 0 is core 0..cores-1, socket 1 is cores..2*cores-1.
LAB_CPU_NUMBERING=contiguous
LAB_SOCKET0_PARITY=even
LAB_RESERVED_CPUS=0-1,60-61
# Must match cpuManagerPolicyOptions on the worker, which
# scripts/configure-cpu-qos.sh always writes as full-pcpus-only: true. Leave it
# true - it is what stops a Guaranteed container from sharing a physical core
# with another workload, which is the whole point of the pinned scenario.
# Setting it false allows thread-granular packing and odd CPU requests.
LAB_FULL_PCPUS_ONLY=true

# ------------------------------------------------- worker power and frequency ----
# Applied by scripts/configure-power.sh (PerfSpect + sysfs), checked by
# scripts/configure-power.sh --verify, scripts/check-bios.sh and
# scripts/preflight.sh. These do not change what a run *asks* for - they decide
# how much frequency the cores it gets actually run at, so a wrong value here
# shows up only as a lower stream count. Defaults are the reference BKC.
#
# intel_pstate driver mode: active (HWP, the reference), passive (acpi_cpufreq-
# style control by the governor), off, or skip to leave the node alone.
LAB_POWER_PSTATE_DRIVER=active
# performance, or powersave to measure what a default install costs.
LAB_POWER_GOVERNOR=performance
# Energy Performance Bias, MSR 0x1B0: 0 = best performance .. 15 = most saving.
LAB_POWER_EPB=0
# Energy Performance Preference, MSR 0x774: 0 = best performance .. 255. Only
# effective with the driver in active mode; under the performance governor
# intel_pstate pins it to 0 and sysfs reports it as "performance".
LAB_POWER_EPP=0
# Efficiency Latency Control: latency, power, or skip. Sierra Forest and newer
# only - on older parts it is simply not applied, which is not an error.
LAB_POWER_ELC=latency

# ---------------------------------------------------------- noisy neighbor ----
# Disabled by default; enable per run with --noisy-neighbor <profile>.
# Profiles are plain env files under noisy-neighbors/.
NOISY_NEIGHBOR_ENABLED=0
NOISY_NEIGHBOR_PROFILE=none
NOISY_NEIGHBOR_SCOPE=pod
NOISY_NEIGHBOR_IMAGE=ghcr.io/colinianking/stress-ng:latest
NOISY_NEIGHBOR_IMAGE_PULL_POLICY=IfNotPresent
NOISY_NEIGHBOR_ARGS=
NOISY_NEIGHBOR_CPU_REQUEST=10m
NOISY_NEIGHBOR_MEMORY_REQUEST=64Mi
NOISY_NEIGHBOR_MEMORY_LIMIT=4Gi
NOISY_NEIGHBOR_POD_COUNT=1
NOISY_NEIGHBOR_GUARANTEED=0
NOISY_NEIGHBOR_HOST_STRESSOR=bandwidth
NOISY_NEIGHBOR_HOST_WORKERS_PER_SOCKET=2
NOISY_NEIGHBOR_HOST_EXTRA_ARGS="--metrics-brief"
# Multi-pod profiles want one neighbor per socket; the runner retries placement
# this many times and can be told to abort when the split is not achieved.
NOISY_NEIGHBOR_SOCKET_SPLIT_RETRIES=2
NOISY_NEIGHBOR_REQUIRE_SOCKET_SPLIT=0
# 1 spreads neighbors one per worker node (hostname anti-affinity across
# LAB_WORKERS) instead of keeping them on the measured worker. Different
# experiment, and it disables the socket-split staging above.
NOISY_NEIGHBOR_SPREAD_BY_NODE=0

# ----------------------------------------------------------------- Intel RDT ----
# Opt-in. --rdt-monitor adds CMT/MBM attribution; --rdt-control <profile>
# additionally applies CAT and/or MBA to the noisy neighbor.
RDT_MONITOR=0
RDT_CONTROL_PROFILE=none
RDT_INTERVAL_SECONDS=1
RDT_INCLUDE_WARMUP=0
