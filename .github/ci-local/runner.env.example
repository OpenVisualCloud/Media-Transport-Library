# Example /etc/mtl-ci/runner.env
#
# Lab facts for a self-hosted MTL runner. Copy this file to
# /etc/mtl-ci/runner.env on the runner and fill in the values for that host.
# The CI scripts source it (see .github/scripts/ci/pytest-setup.sh); set
# MTL_CI_RUNNER_ENV to point somewhere else when testing locally.
#
# Every value here used to be a GitHub repository secret. They are not secrets
# in any useful sense: they describe hardware that only this host can reach, and
# a second copy in GitHub has to be kept in sync by hand. Anything genuinely
# secret (Coverity credentials, the GitHub token) stays in GitHub.
#
# All keys are optional; each one has a working default.

# Account the acceptance tests run as. Default: the user running the job.
#RUNNER_USERNAME=mtl

# MTL checkout/build to test against. Default: the checked-out workspace.
#MTL_PATH=/home/mtl/Media-Transport-Library

# EBU LIST instance used for ST 2110 compliance verdicts. With EBU_IP unset the
# tests still run, they just do not produce a compliance verdict.
#EBU_IP=192.168.1.10
#EBU_USER=ebu
#EBU_PASSWORD=changeme

# Performance rig only (perf-pytest.yml). SUT_IP is the system under test;
# PCI_DEVICE overrides the default E830 pair used by `pytest-setup.sh pci-env`.
#SUT_IP=192.168.1.20
#PCI_DEVICE=8086:12d2,8086:12d2
