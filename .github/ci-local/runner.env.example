# Example /etc/mtl-ci/runner.env
#
# Lab facts for a self-hosted MTL runner. Copy this file to
# /etc/mtl-ci/runner.env on the runner and fill in the values for that host.
# The CI scripts source it (see .github/scripts/ci/pytest-setup.sh); set
# MTL_CI_RUNNER_ENV to point somewhere else when testing locally.
#
# Every value here used to be a GitHub repository secret. They are not secrets
# in any useful sense: they describe hardware that only this host can reach, and
# a second copy in GitHub has to be kept in sync by hand. Anything genuinely
# secret (Coverity credentials, the GitHub token) stays in GitHub.
#
# All keys are optional; each one has a working default.

# Account the acceptance tests run as. Default: the user running the job.
#RUNNER_USERNAME=mtl

# The private key that account logs in with. Default: id_ed25519 in its ~/.ssh.
#
# The suite reaches the DUT over SSH even when the DUT is this host -- the
# generated config says `ip_address: 127.0.0.1, connection_type: SSHConnection` --
# so this key must be in the account's own authorized_keys, or every case fails
# at fixture setup. `task ci:pytest-setup -- connection` checks it in a second and
# prints the command that fixes it.
#RUNNER_SSH_KEY=/home/mtl/.ssh/id_ed25519

# MTL checkout/build to test against. Default: the checked-out workspace.
#MTL_PATH=/home/mtl/Media-Transport-Library

# EBU LIST instance used for ST 2110 compliance verdicts. With EBU_IP unset the
# tests still run, they just do not produce a compliance verdict.
#
# EBU_IP is a bare host or host:port, never a URL: the framework's client builds
# http://$EBU_IP/auth/login itself, so a scheme here produces a malformed URL. A
# host running its own analyser uses 127.0.0.1, since the stack publishes port 80.
# `task ci:ebu-list -- verify` checks all three against the live instance.
#EBU_IP=192.168.1.10
#EBU_USER=ebu
#EBU_PASSWORD=changeme

# Once this host has an analyser, say so, and losing it becomes a failed leg
# instead of a leg that quietly stops judging compliance. Leave it unset while
# the analyser is still being brought up: `task ci:ebu-list -- verify` then
# reports the missing verdict on the run's summary and lets the tests run.
#MTL_CI_REQUIRE_COMPLIANCE=1

# Where the EBU LIST docker compose stack was cloned, for `task ci:ebu-list`.
# Default: $HOME/mtl/devtools/ebu-list, the ebu-list directory of the internal
# Media-Transport-Library-Devtools repository. It is deliberately outside the MTL
# checkout so it never shows up in `git status`.
#EBU_LIST_DIR=/home/mtl/devtools/ebu-list

# Performance rig only (perf-pytest.yml). SUT_IP is the system under test;
# PCI_DEVICE overrides the default E830 pair used by `pytest-setup.sh pci-env`.
#SUT_IP=192.168.1.20
#PCI_DEVICE=8086:12d2,8086:12d2
