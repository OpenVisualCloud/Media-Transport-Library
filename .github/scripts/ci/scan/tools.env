# The binary-hardening scanners of hardening-tools.sh, pinned. A download that
# doesn't match its hash is not run.

# checksec (github.com/slimm609/checksec). To refresh: the version, and the
# sha512 of its archive in the checksec_checksums.sha512 of the release.
CHECKSEC_VERSION=3.2.0
CHECKSEC_SHA512=a5bdee9f82c9e0ee2c57fbbea7f64c4bec139cec989122145412827ca2f54a74614d568125f2f37e75c7931d50ecf9d4d80535b227563e4b2ca2ee23f588e146

# hardening-check.pl of salsa.debian.org/debian/devscripts, tag v2.26.13. To
# refresh: the commit of the new tag, and the sha256sum of the raw file at it.
HARDENING_CHECK_COMMIT=06637ee85effcc6b020237f5dbf16945eb908453
HARDENING_CHECK_SHA256=850c4940464c628578918cfa31dc7056de5a321c99d5328fe475254c8f904667
