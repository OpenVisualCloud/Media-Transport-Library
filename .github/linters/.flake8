[flake8]
# Vendored verbatim from super-linter v6's TEMPLATES/.flake8, which is what CI has
# been enforcing implicitly. Kept byte-equivalent so moving the check into
# pre-commit changes nothing: measured 0 findings over all 213 tracked *.py.
# E203 conflicts with black's slice formatting.
max-line-length = 120
extend-ignore = E203
