venv*
.github/mcp/.venv/

# Local CI reproduction (.github/ci-local)
.ci-local/

# Test reports the pytest suites write into the workspace root, which the
# workflow uploads as an artifact rather than committing.
/report.html
/report.json
# The custom, nightly and performance suites write theirs next to the tests.
tests/acceptance/report.html
tests/acceptance/report.json

# The JPEG XS producer unpacks its upstream source next to the script that
# builds it -- .github/scripts/SVT-JPEG-XS-<revision>, see
# .github/scripts/ci/build-jpegxs.sh -- and everything under .github is
# force-added above, so on any host that has built the dependency caches that
# tree is reported as untracked. It is a download, not a source file.
.github/scripts/SVT-JPEG-XS-*

# Claude Code personal settings
.claude/settings.local.json

# Acceptance install trees. .local_install is a symlink to one of the other two
# during an A/B run. See tasks.md, "Acceptance A/B with two install trees".
.local_install
local_install_old/
local_install_new/
