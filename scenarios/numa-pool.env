# Case 2 of 3: NUMA locality only.
# Still Burstable and still shared, but each session is tasksetted to the CPUs
# of one socket and sessions alternate sockets. Threads keep their memory local
# without giving up elasticity inside the socket.
SCENARIO=numa-pool
DESCRIPTION="NUMA pool: sessions alternate sockets and share only CPUs inside their socket"
PLACEMENT=numa-pool
RESOLUTION=1080p
STREAMS=1
PRESET=medium
BITRATE=12M
DEC_THREADS=
FILTER_THREADS=
ENC_THREADS=15
SLICES=2
DEC_CPU_REQUEST=500m
ENC_CPU_REQUEST=500m
DEC_MEMORY=2Gi
ENC_MEMORY=1Gi
