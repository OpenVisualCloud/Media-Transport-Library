# Case 3 of 3: full CPU QoS.
# Guaranteed Pods with integer CPU requests equal to limits, so the kubelet
# static CPU Manager hands each container its own exclusive cores and the
# single-numa-node Topology Manager keeps each container NUMA-local.
# 1 decoder CPU + 5 encoder CPUs per session. No taskset is used: kubelet owns
# the cpuset. ENC_THREADS=15 > ENC_CORES=5 is intentional - frame threading
# (SLICED_THREADS=0) time-slices 15 threads over the 5 exclusive CPUs.
SCENARIO=pinned
DESCRIPTION="Pinned: Guaranteed Pods, kubelet static CPU Manager assigns 1 decoder + 5 encoder exclusive CPUs"
PLACEMENT=exclusive
RESOLUTION=1080p
STREAMS=1
PRESET=medium
BITRATE=12M
DEC_THREADS=1
FILTER_THREADS=1
ENC_THREADS=15
SLICES=2
SLICED_THREADS=0
DEC_CORES=1
ENC_CORES=5
DEC_CPU_REQUEST=1
ENC_CPU_REQUEST=5
DEC_MEMORY=2Gi
ENC_MEMORY=1Gi
