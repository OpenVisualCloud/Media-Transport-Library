# Case 1 of 3: no optimizations.
# Burstable Pods, no CPU pinning, no NUMA hint. The Linux scheduler is free to
# place and migrate every FFmpeg thread anywhere on the worker, including across
# sockets. This is the reference every optimization is measured against.
SCENARIO=baseline
DESCRIPTION="Baseline: free scheduling, Burstable Pods, no CPU or NUMA constraints"
PLACEMENT=free
RESOLUTION=1080p
STREAMS=1
PRESET=medium
BITRATE=12M
DEC_THREADS=
FILTER_THREADS=
ENC_THREADS=15
SLICES=2
DEC_CPU_REQUEST=500m
ENC_CPU_REQUEST=500m
DEC_MEMORY=2Gi
ENC_MEMORY=1Gi
