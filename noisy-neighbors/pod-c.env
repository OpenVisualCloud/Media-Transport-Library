# Pod-C: two Guaranteed neighbor Pods, one per socket, 24 exclusive CPUs each.
# Worst realistic co-tenant: saturates both the LLC and the memory controllers.
#
# Reference measurement on the reference platform: 520 MiB LLC, 462 GB/s
# DRAM, worker L3 hit ratio collapsing to about 14%.
NOISY_NEIGHBOR_ARGS="--stream 24
--stream-index 0
--stream-l3-size 512M
--metrics-brief
--timeout 0
--log-file stress-ng.log"
NOISY_NEIGHBOR_SCOPE=pod
NOISY_NEIGHBOR_CPU_REQUEST=24
NOISY_NEIGHBOR_MEMORY_REQUEST=16Gi
NOISY_NEIGHBOR_MEMORY_LIMIT=16Gi
NOISY_NEIGHBOR_POD_COUNT=2
NOISY_NEIGHBOR_GUARANTEED=1
NOISY_NEIGHBOR_SOCKET_SPLIT_RETRIES=3
NOISY_NEIGHBOR_REQUIRE_SOCKET_SPLIT=1
