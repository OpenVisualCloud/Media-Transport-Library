# Host-A: a noisy neighbor that is NOT a Kubernetes Pod.
#
# Two stress-ng STREAM groups started over SSH, one bound to each socket with
# taskset + numactl --membind. Because it lives outside kubepods it can run on
# CPUs the kubelet handed exclusively to pinned FFmpeg containers, so it adds
# CPU contention on top of memory contention. This is the hardest case: RDT can
# take away its cache and bandwidth but cannot give back the CPU time it steals.
#
# Reference measurement on the reference platform: ~5 busy cores, 284 MiB LLC, 74 GB/s DRAM.
NOISY_NEIGHBOR_SCOPE=host
NOISY_NEIGHBOR_IMAGE=host:/usr/bin/stress-ng
NOISY_NEIGHBOR_HOST_STRESSOR=bandwidth
NOISY_NEIGHBOR_HOST_WORKERS_PER_SOCKET=2
NOISY_NEIGHBOR_HOST_EXTRA_ARGS="--metrics-brief"
# Documentation only; the runner builds the real command per socket.
NOISY_NEIGHBOR_ARGS="numactl --membind=<socket> --stream 2 --stream-l3-size 32M --stream-index 0 --metrics-brief --timeout 0 (per socket)"
