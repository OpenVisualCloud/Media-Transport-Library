# Pod-B: two Guaranteed neighbor Pods, one per socket, 12 exclusive CPUs each.
# Heavy DRAM pressure with a working set far larger than the LLC.
#
# Reference measurement on the reference platform: 471 MiB LLC, 279 GB/s DRAM.
NOISY_NEIGHBOR_ARGS="--stream 24
--stream-index 0
--stream-l3-size 196M
--metrics-brief
--timeout 0
--log-file stress-ng.log"
NOISY_NEIGHBOR_SCOPE=pod
NOISY_NEIGHBOR_CPU_REQUEST=12
NOISY_NEIGHBOR_MEMORY_REQUEST=16Gi
NOISY_NEIGHBOR_MEMORY_LIMIT=16Gi
NOISY_NEIGHBOR_POD_COUNT=2
NOISY_NEIGHBOR_GUARANTEED=1
NOISY_NEIGHBOR_SOCKET_SPLIT_RETRIES=3
NOISY_NEIGHBOR_REQUIRE_SOCKET_SPLIT=1
