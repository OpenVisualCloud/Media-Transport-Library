    {
      "type": "row",
      "title": "Interconnect / NUMA",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 65
      }
    },
    {
      "type": "timeseries",
      "title": "UPI incoming utilisation \u2014 max and per socket (%)",
      "description": "Shows the most utilised incoming UPI link overall and, for each socket, the most utilised incoming link on that socket.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 66
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max({__name__=~\"Utilization_Incoming_Data_Traffic_On_Link_[0-3]\",aggregate=\"system\",socket=\"\",instance=~\"$instance\"})",
          "legendFormat": "max incoming utilisation"
        },
        {
          "refId": "B",
          "expr": "max by (socket) ({__name__=~\"Utilization_Incoming_Data_Traffic_On_Link_[0-3]\",aggregate=\"\",socket=~\"$socket\",instance=~\"$instance\"})",
          "legendFormat": "socket {{socket}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "UPI incoming utilisation per link (%)",
      "description": "Breaks out the incoming utilisation exported on each PCM UPI link counter.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 66
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
