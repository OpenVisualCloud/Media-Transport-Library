            "mean"
          ],
          "placement": "right"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "perfspect_L1_Bound{job=\"perfspect-exporter\"}",
          "legendFormat": "L1 Bound"
        },
        {
          "refId": "B",
          "expr": "perfspect_L2_Bound{job=\"perfspect-exporter\"}",
          "legendFormat": "L2 Bound"
