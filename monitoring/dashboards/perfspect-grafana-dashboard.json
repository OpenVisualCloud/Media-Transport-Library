{
  "uid": "intel-perfspect-mxl",
  "title": "Intel PerfSpect — k8s-w2 (FFmpeg-MXL Scenario 1)",
  "tags": [
    "intel",
    "perfspect",
    "crm-workloads",
    "tma"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 0,
  "refresh": "30s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Top-Down Microarchitecture Analysis (TMA)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "TMA Level 1 — pipeline-slot breakdown (%)",
      "description": "Where the CPU's issue slots go. The four sum to ~100%. Backend_Bound dominating means the workload waits on data/execution resources rather than instruction supply. PerfSpect publishes already-computed percentages (gauges) — no rate() needed.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 35,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "calcs": [
            "lastNotNull",
            "mean"
          ],
          "placement": "right"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "perfspect_Frontend_Bound{job=\"perfspect-exporter\"}",
          "legendFormat": "Frontend Bound"
        },
        {
          "refId": "B",
          "expr": "perfspect_Bad_Speculation{job=\"perfspect-exporter\"}",
          "legendFormat": "Bad Speculation"
        },
        {
          "refId": "C",
          "expr": "perfspect_Backend_Bound{job=\"perfspect-exporter\"}",
          "legendFormat": "Backend Bound"
        },
        {
          "refId": "D",
          "expr": "perfspect_Retiring{job=\"perfspect-exporter\"}",
          "legendFormat": "Retiring (useful)"
        }
      ]
    },
    {
      "type": "stat",
      "title": "TMA now (%)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 1
      },
